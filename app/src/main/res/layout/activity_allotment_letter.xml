<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/grey"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/applicationStatusHeader"
                layout="@layout/vahan_echallan_header"/>
            <LinearLayout
                android:gravity="top|left"
                android:orientation="vertical"
                android:background="@drawable/mvvm_linear"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/_10sdp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.nic.mparivahan.MyTextView
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/idLayoutTitle"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="View Allotment Letter"/>
                    <com.nic.mparivahan.MyTextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/application_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Receipt No."
                        android:fontFamily="@font/nexgenttf"/>
                    <androidx.appcompat.widget.AppCompatEditText
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@color/black"
                        android:gravity="center_vertical"
                        android:id="@+id/txt_rcptnumber"
                        android:background="@drawable/sign_in_back"
                        android:padding="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Enter Receipt No."
                        android:singleLine="true"
                        android:maxLength="20"
                        android:inputType="textCapCharacters"
                        android:imeOptions="actionDone"
                        android:fontFamily="@font/nexgenttf"/>
                    <com.nic.mparivahan.MyTextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/never_mix"
                        android:gravity="center"
                        android:id="@+id/time_text"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/nexgenttf"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/idSubmit"
                        android:background="@drawable/button_cyan_theme"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_30sdp"
                        android:minHeight="50dp"
                        android:text="@string/submit"
                        android:textAllCaps="false"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/light_cyan"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/idCancel"
                        android:background="@drawable/button_cyan_border_theme"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:minHeight="50dp"
                        android:text="@string/cancel"
                        android:shadowColor="@color/dark_grey"
                        android:textAllCaps="false"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
