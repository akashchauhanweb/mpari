<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_dl_replacement_0"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mHeader_layout"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/multi_head"
            android:visibility="gone"
            layout="@layout/multiheader"/>
        <include
            android:id="@+id/mHeader"
            android:visibility="visible"
            layout="@layout/mvvm_header"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="top|left"
        android:orientation="vertical"
        android:background="@drawable/mvvm_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/mHeader_layout">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/never_mix"
                android:gravity="center"
                android:id="@+id/dl_no_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/never_mix"
                android:gravity="center"
                android:id="@+id/txt_view_details"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginRight="@dimen/_7sdp"
                android:text="@string/view_dl_details"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_10sdp">
            <com.nic.mparivahan.dlservices.widget.MyTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/select_service"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/poppins_regular"/>
            <LinearLayout
                android:gravity="center"
                android:padding="1dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:id="@+id/icon_image"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginLeft="20dp"
                    android:layout_centerHorizontal="true"
                    app:cardCornerRadius="30dp">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/avtar_icon"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/round_card_view"
                    android:visibility="visible"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginLeft="0dp"
                    android:layout_centerHorizontal="true"
                    app:cardCornerRadius="30dp">
                    <ImageView
                        android:id="@+id/iv_report_traffic_violation_icon"
                        android:layout_width="50dp"
                        android:layout_height="50dp"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_8sdp">
            <include
                android:id="@+id/psl"
                layout="@layout/photo_signature_link"/>
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/_4sdp">
                <androidx.recyclerview.widget.RecyclerView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/multi_steps"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_no_input_req"
                    android:background="@drawable/items_dl_renewal_stage"
                    android:padding="@dimen/_15sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="No input required for this service accepted succesfully"
                    android:fontFamily="@font/roboto_medium"
                    android:justificationMode="inter_word"/>
                <com.nic.mparivahan.dlservices.widget.MyTextView
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/black"
                    android:id="@+id/txtAppCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="@string/app_category"
                    android:fontFamily="@font/roboto_medium"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">
                    <Spinner
                        android:id="@+id/spn_app_cat"
                        android:background="@drawable/edit_text_style"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/_35sdp"
                        android:textAllCaps="true"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:padding="@dimen/_5sdp"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginRight="@dimen/_5sdp"
                        android:src="@drawable/a1"/>
                </FrameLayout>
                <com.nic.mparivahan.dlservices.widget.MyTextView
                    android:textSize="@dimen/_15sdp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_declation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="Declaration"
                    android:fontFamily="@font/robot_bold"/>
                <CheckBox
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:gravity="top"
                    android:id="@+id/decelerate_cb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text=" I hereby declare that to the best of my knowledge and select the particulars given above are true I declare that the facts stated above and information submitted are true and genuine to the best of my knowledge and belief."/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/donate_layout"
                    android:background="@drawable/items_dl_renewal_stage"
                    android:padding="@dimen/_10ssp"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/_13sdp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_note_organ_donate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:text="I am willing to donate my organ / tissue in case of death."
                        android:fontFamily="@font/roboto_medium"/>
                    <RadioGroup
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:id="@+id/willing_to_donate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="YES"/>
                        <RadioButton
                            android:id="@+id/no_willing_to_donate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_10sdp"
                            android:text="NO"/>
                    </RadioGroup>
                    <androidx.appcompat.widget.AppCompatEditText
                        android:textSize="14dp"
                        android:id="@+id/org_mob_number"
                        android:background="@drawable/edit_text_style"
                        android:padding="10dp"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Enter your emergency contact number"
                        android:maxLength="10"
                        android:inputType="number"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginBottom="@dimen/_10ssp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_7sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:layout_alignParentBottom="true">
        <com.nic.mparivahan.dlservices.widget.CustomWegetLayout
            android:id="@+id/reset"
            android:background="@drawable/button_white_theme"
            android:layout_width="0dp"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_5sdp"
            app:buttonText="Reset"
            app:buttonTextColor="@color/never_mix"
            app:buttonTextSize="14sp"
            app:progressColor="#ffffffff"
            app:progressWidth="1dp"/>
        <com.nic.mparivahan.dlservices.widget.CustomWegetLayout
            android:id="@+id/id_next_service"
            android:background="@drawable/sign_in_new"
            android:layout_width="0dp"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_weight="1"
            app:buttonText="Submit"
            app:buttonTextColor="@color/white"
            app:buttonTextSize="14sp"
            app:progressColor="#ffffffff"
            app:progressWidth="1dp"/>
    </LinearLayout>
</RelativeLayout>
