<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/topHolder"
                layout="@layout/vahan_echallan_header"/>
            <LinearLayout
                android:gravity="top|left"
                android:orientation="vertical"
                android:background="@drawable/mvvm_linear"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.nic.mparivahan.MyTextView
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/selectedServiceTv"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/vehicle_service"
                        android:fontFamily="@font/poppins_regular"/>
                    <TextView
                        android:textSize="@dimen/_14ssp"
                        android:textColor="@color/black"
                        android:id="@+id/aadher_title"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:text="Aadhar based eKYC of vehicle owner"
                        android:fontFamily="@font/robot_bold"/>
                    <com.nic.mparivahan.MyTextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/vehicle_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/vehicle_number"/>
                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/txt_vehicle_number"
                        android:background="@drawable/sign_in_back"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginTop="10dp"
                        android:textAllCaps="true"/>
                    <TextView
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/enterVirtualIdTv"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/please_enter_aadhaar"
                        android:justificationMode="inter_word"/>
                    <RadioGroup
                        android:id="@+id/radioGroup_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false">
                            <RadioButton
                                android:textSize="14sp"
                                android:id="@+id/adhar_radio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/aadhar_no"
                                android:layout_weight="1"/>
                            <RadioButton
                                android:textSize="14sp"
                                android:id="@+id/vid_radio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="@string/vid"
                                android:layout_weight="1"/>
                        </LinearLayout>
                    </RadioGroup>
                    <EditText
                        android:textColor="@color/black"
                        android:id="@+id/et_otp"
                        android:background="@drawable/sign_in_back"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginTop="10dp"
                        android:hint="@string/enter_aadhaar_number"
                        android:maxLength="12"
                        android:inputType="textPassword"
                        android:importantForAutofill="no"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/termCndLl"
                        android:paddingBottom="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp">
                        <CheckBox
                            android:gravity="center"
                            android:id="@+id/dec_kyc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"/>
                        <com.nic.mparivahan.MyTextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:gravity="top|left"
                            android:id="@+id/terms_conditions"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginTop="15dp"
                            android:text="@string/agree_with_aadhar_terms"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/generateOtpLl"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false">
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/gray"
                            android:gravity="center"
                            android:id="@+id/disPlay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="30dp"
                            android:layout_marginRight="10dp"
                            android:fontFamily="@font/nexgenttf"/>
                        <com.nic.mparivahan.MyTextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@+id/enter_otp2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/enter_otp"
                            android:fontFamily="@font/nexgenttf"/>
                        <FrameLayout
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp">
                            <EditText
                                android:id="@+id/enterOtp"
                                android:background="@drawable/sign_in_back"
                                android:padding="15dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/enter_otp"
                                android:maxLength="6"
                                android:digits=" 0123456789"
                                android:inputType="numberPassword"
                                android:importantForAutofill="no"/>
                            <LinearLayout
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:layout_width="70dp"
                                android:layout_height="match_parent">
                                <ImageView
                                    android:id="@+id/showmpin"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginRight="35dp"
                                    android:src="@drawable/mvvm_visibility"/>
                            </LinearLayout>
                        </FrameLayout>
                        <com.nic.mparivahan.MyTextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/never_mix"
                            android:gravity="center"
                            android:id="@+id/time_text"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/nexgenttf"/>
                        <com.nic.mparivahan.MyTextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/never_mix"
                            android:gravity="center"
                            android:id="@+id/resendOtp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/resend_otp"
                            android:fontFamily="@font/nexgenttf"/>
                    </LinearLayout>
                    <com.nic.mparivahan.MyTextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/notes"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/notes"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/faceless_services"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/faceless_services"
                        android:fontFamily="@font/nexgenttf"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="bottom"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/processLl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="15dp"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/txt_reset"
                android:background="@drawable/button_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:minHeight="50dp"
                android:text="@string/reset"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/txt_service_submit"
                android:background="@drawable/button_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:minHeight="50dp"
                android:text="@string/generate_otp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="bottom"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/otpBtnLl"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="15dp"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/verify_user"
                android:background="@drawable/sign_in_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:minHeight="50dp"
                android:text="@string/submit"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/txt_reset_otp"
                android:background="@drawable/sign_in_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:minHeight="50dp"
                android:text="@string/reset"
                android:layout_weight="1"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
