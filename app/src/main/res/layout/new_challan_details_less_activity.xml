<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/topHolder"
        layout="@layout/vahan_echallan_header"/>
    <androidx.core.widget.NestedScrollView
        android:background="@drawable/mvvm_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_10sdp"
        android:fillViewport="true"
        android:layout_below="@+id/topHolder">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:baselineAligned="false"
            android:layout_marginHorizontal="12dp">
            <RelativeLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <CheckedTextView
                    android:textColor="@color/firefly"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/paymentCb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="@string/payment"
                    android:minLines="2"
                    android:drawableTop="@drawable/custom_checkbox"
                    android:layout_centerInParent="true"
                    android:textAlignment="gravity"/>
                <View
                    android:id="@+id/paymentView"
                    android:background="@color/geyser"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="15dp"
                    android:layout_toLeftOf="@+id/paymentCb"
                    android:layout_toRightOf="@+id/challanDetailsCb"
                    android:layout_toStartOf="@+id/paymentCb"
                    android:layout_toEndOf="@+id/challanDetailsCb"/>
                <CheckedTextView
                    android:textColor="@color/firefly"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/challanDetailsCb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/challan_details"
                    android:minLines="2"
                    android:drawableTop="@drawable/custom_checkbox"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:textAlignment="gravity"
                    android:layout_alignParentStart="true"/>
                <View
                    android:background="@color/geyser"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="15dp"
                    android:layout_toLeftOf="@+id/receiptCb"
                    android:layout_toRightOf="@+id/paymentCb"
                    android:layout_toStartOf="@+id/receiptCb"
                    android:layout_toEndOf="@+id/paymentCb"/>
                <CheckedTextView
                    android:textColor="@color/firefly"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/receiptCb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="@string/receipt"
                    android:minLines="2"
                    android:drawableTop="@drawable/custom_checkbox"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:textAlignment="gravity"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:baselineAligned="false"
                android:weightSum="1">
                <com.nic.mparivahan.MyTextView
                    android:textSize="14sp"
                    android:textColor="@color/oslo_grey"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/accusedNameTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/accused_name"
                    android:maxLines="2"
                    android:layout_weight="0.3"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="5dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="#cc000000"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:id="@+id/accusedNameValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:maxLines="2"
                    android:layout_weight="0.7"
                    android:textAlignment="gravity"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:weightSum="1">
                <com.nic.mparivahan.MyTextView
                    android:textSize="14sp"
                    android:textColor="@color/oslo_grey"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/rcNoTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/rc_no"
                    android:maxLines="2"
                    android:layout_weight="0.3"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="5dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="#cc000000"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:id="@+id/rcNoValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:maxLines="2"
                    android:layout_weight="0.7"
                    android:textAlignment="gravity"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/dlNoHolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:weightSum="1">
                <com.nic.mparivahan.MyTextView
                    android:textSize="14sp"
                    android:textColor="@color/oslo_grey"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/dlNoTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/dl_no"
                    android:maxLines="2"
                    android:layout_weight="0.3"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="5dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="#cc000000"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:id="@+id/dlNoValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:maxLines="2"
                    android:layout_weight="0.7"
                    android:textAlignment="gravity"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:weightSum="1">
                <com.nic.mparivahan.MyTextView
                    android:textSize="14sp"
                    android:textColor="@color/oslo_grey"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/challanTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/challan_no"
                    android:maxLines="2"
                    android:layout_weight="0.3"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="5dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="#cc000000"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:id="@+id/challanValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:maxLines="2"
                    android:layout_weight="0.7"
                    android:textAlignment="gravity"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:weightSum="1">
                <com.nic.mparivahan.MyTextView
                    android:textSize="14sp"
                    android:textColor="@color/oslo_grey"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/challanDateTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Challan Date"
                    android:maxLines="2"
                    android:layout_weight="0.3"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="5dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="#cc000000"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:id="@+id/challanDateValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:maxLines="2"
                    android:layout_weight="0.7"
                    android:textAlignment="gravity"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:weightSum="1">
                <com.nic.mparivahan.MyTextView
                    android:textSize="14sp"
                    android:textColor="@color/oslo_grey"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/stateTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/state_new"
                    android:maxLines="2"
                    android:layout_weight="0.3"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="5dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="#cc000000"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:id="@+id/stateValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:maxLines="2"
                    android:layout_weight="0.7"
                    android:textAlignment="gravity"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:weightSum="1">
                <com.nic.mparivahan.MyTextView
                    android:textSize="14sp"
                    android:textColor="@color/oslo_grey"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/challanPlaceTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:maxLines="4"
                    android:layout_weight="0.3"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="5dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="#cc000000"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:id="@+id/challanPlaceValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:maxLines="4"
                    android:layout_weight="0.7"
                    android:textAlignment="gravity"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:weightSum="1">
                <com.nic.mparivahan.MyTextView
                    android:textSize="14sp"
                    android:textColor="@color/oslo_grey"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/offenceTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/offence"
                    android:maxLines="2"
                    android:layout_weight="0.3"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="5dp"/>
                <io.github.glailton.expandabletextview.ExpandableTextView
                    android:textSize="16sp"
                    android:textColor="#cc000000"
                    android:gravity="end"
                    android:layout_gravity="end"
                    android:id="@+id/expandableTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.7"
                    android:textAlignment="gravity"
                    app:collapsedLines="1"
                    app:isExpanded="false"
                    app:textMode="line"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:weightSum="1">
                <com.nic.mparivahan.MyTextView
                    android:textSize="14sp"
                    android:textColor="@color/oslo_grey"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/statusTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/status"
                    android:maxLines="2"
                    android:layout_weight="0.3"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="5dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="#cc0eb2ff"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:id="@+id/statusValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:maxLines="2"
                    android:layout_weight="0.7"
                    android:textAlignment="gravity"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/viewMoreTv"
                android:background="@drawable/corner_rectangle_bg_14_with_shadow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_more"
                android:maxLines="1"
                android:fontFamily="@font/robot_bold"
                android:layout_marginVertical="20dp"
                android:paddingVertical="14dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ProgressBar
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_centerInParent="true"/>
</RelativeLayout>
