<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="100dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/dashboard_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="25dp"
                            android:layout_marginTop="25dp">
                            <com.nic.mparivahan.dlservices.widget.CircleImageView
                                android:id="@+id/userIv"
                                android:visibility="visible"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:src="@drawable/avtar"/>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/black"
                                    android:gravity="center"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp"
                                    android:text="Welcome"
                                    android:fontFamily="@font/nexgenttf"/>
                                <TextView
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/white"
                                    android:id="@+id/full_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp"
                                    android:textAllCaps="true"
                                    android:fontFamily="@font/nexgenttf"/>
                            </LinearLayout>
                        </LinearLayout>
                        <ImageView
                            android:layout_gravity="center"
                            android:visibility="invisible"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginLeft="20dp"
                            android:src="@drawable/ic_launcher"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="bottom"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="20dp">
                        <FrameLayout
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="25dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginRight="25dp">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:background="@drawable/dashboard"
                                android:layout_width="match_parent"
                                android:layout_height="45dp"
                                android:weightSum="6">
                                <LinearLayout
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="2">
                                    <androidx.appcompat.widget.AppCompatSpinner
                                        android:gravity="center"
                                        android:id="@+id/app_option"
                                        android:background="@drawable/spinner"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_marginLeft="2dp"
                                        android:spinnerMode="dialog"/>
                                </LinearLayout>
                                <TextView
                                    android:gravity="center"
                                    android:id="@+id/Search_bar"
                                    android:paddingLeft="10dp"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:hint="@string/search"
                                    android:layout_weight="3"/>
                                <LinearLayout
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@+id/ll_search"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginRight="5dp"
                                    android:layout_weight="1">
                                    <ImageView
                                        android:gravity="center"
                                        android:background="@drawable/mvvm_search"
                                        android:layout_width="25dp"
                                        android:layout_height="25dp"/>
                                </LinearLayout>
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:padding="0dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="15dp">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/drive"/>
                        <TextView
                            android:textSize="@dimen/dashboard_txt"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/trans_services"
                            android:fontFamily="sans-serif-light"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/mvvm_ic"/>
                        <TextView
                            android:textSize="@dimen/dashboard_txt"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/my_docs"
                            android:fontFamily="sans-serif-light"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_citizen_sentinel"/>
                        <TextView
                            android:textSize="@dimen/dashboard_txt"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/cit_sen"
                            android:fontFamily="sans-serif-light"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:padding="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/mvvm_tax"/>
                        <TextView
                            android:textSize="@dimen/dashboard_txt"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/inf_Serv"
                            android:fontFamily="sans-serif-light"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:padding="1dp"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="5dp"
                    android:weightSum="4">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:padding="3dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/ll_transport_services"
                            android:background="@drawable/corner_rectangle_bg_17"
                            android:padding="3dp"
                            android:layout_width="70dp"
                            android:layout_height="90dp"
                            android:layout_margin="2dp">
                            <ImageView
                                android:id="@+id/iv_ts"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/ic_transport_selected"/>
                            <com.nic.mparivahan.MyTextView
                                android:textSize="10sp"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/txt_ts"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/trans_services"
                                android:fontFamily="sans-serif-light"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:padding="3dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/ll_my_docs"
                            android:padding="3dp"
                            android:layout_width="70dp"
                            android:layout_height="90dp"
                            android:layout_margin="2dp">
                            <ImageView
                                android:id="@+id/iv_md"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/ic_my_documents"/>
                            <com.nic.mparivahan.MyTextView
                                android:textSize="10sp"
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/txt_md"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/my_documents"
                                android:fontFamily="@font/robot_bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:padding="3dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/ll_citizen"
                            android:padding="3dp"
                            android:layout_width="70dp"
                            android:layout_height="90dp"
                            android:layout_margin="2dp">
                            <ImageView
                                android:id="@+id/iv_cs"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/ic_citizen_sentinel"/>
                            <com.nic.mparivahan.MyTextView
                                android:textSize="10sp"
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/txt_cs"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/cit_sen"
                                android:fontFamily="@font/robot_bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:padding="3dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/ll_info"
                            android:padding="3dp"
                            android:layout_width="70dp"
                            android:layout_height="90dp"
                            android:layout_margin="2dp">
                            <ImageView
                                android:id="@+id/iv_is"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_informational_services"/>
                            <com.nic.mparivahan.MyTextView
                                android:textSize="10sp"
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/txt_is"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/inf_Serv"
                                android:fontFamily="@font/robot_bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <include
                    android:id="@+id/home_alert_layout"
                    layout="@layout/home_alert_layout"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/virtual_rc_textview"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="10dp"
                    android:text="Virtual RC"
                    android:fontFamily="sans-serif-light"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rec_rc_recycler"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/nodocument"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="100dp"
                    android:text="No Documents Available"
                    android:fontFamily="sans-serif-light"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/virtual_dl_textview"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:text="Virtual DL"
                    android:fontFamily="sans-serif-light"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rec_dl_recycler"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"/>
                <include
                    android:id="@+id/ll_dashboard_dl"
                    android:visibility="gone"
                    layout="@layout/dl_dashboard"/>
                <include
                    android:id="@+id/transport_layout"
                    android:visibility="visible"
                    layout="@layout/layout_options"/>
                <include
                    android:id="@+id/accident_layout"
                    android:visibility="gone"
                    layout="@layout/layout_citizen_accident"/>
                <include
                    android:id="@+id/info_layout"
                    android:visibility="gone"
                    layout="@layout/informational_layout"/>
                <com.nic.mparivahan.MyTextView
                    android:textSize="25sp"
                    android:textColor="@color/gray"
                    android:gravity="center"
                    android:id="@+id/txt_process"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="80dp"
                    android:text="Available Soon\10(Under Development)"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:background="@drawable/spinner"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1">
                        <ImageView
                            android:layout_width="35dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_pay_challan"/>
                        <TextView
                            android:textSize="@dimen/dashboard_txt"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Home"
                            android:fontFamily="sans-serif-light"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1">
                        <ImageView
                            android:layout_width="35dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_pay_challan"/>
                        <TextView
                            android:textSize="@dimen/dashboard_txt"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Payment"
                            android:fontFamily="sans-serif-light"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1">
                        <ImageView
                            android:layout_width="35dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_pay_challan"/>
                        <TextView
                            android:textSize="@dimen/dashboard_txt"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Document"
                            android:fontFamily="sans-serif-light"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1">
                        <ImageView
                            android:layout_width="35dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_pay_challan"/>
                        <TextView
                            android:textSize="@dimen/dashboard_txt"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Setting"
                            android:fontFamily="sans-serif-light"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
