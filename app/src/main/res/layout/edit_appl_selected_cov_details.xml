<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/edit_appl_selected_cov_details_0"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <include
        android:id="@+id/mHeader"
        layout="@layout/sarathi_header"/>
    <LinearLayout
        android:gravity="top|left"
        android:orientation="vertical"
        android:background="@drawable/mvvm_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/_10sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/edit_text_style"
                    android:padding="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:baselineAligned="false"
                    android:backgroundTint="#fff1f6f8">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp">
                        <TextView
                            android:textSize="@dimen/_12ssp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:gravity="center_vertical"
                            android:id="@+id/txt_app_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/select_class_of_vehcile"
                            android:layout_centerVertical="true"/>
                        <ImageView
                            android:id="@+id/infoIv"
                            android:layout_width="@dimen/_14sdp"
                            android:layout_height="@dimen/_14sdp"
                            android:src="@drawable/info"
                            android:scaleType="fitCenter"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_toEndOf="@+id/txt_app_category"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/covListLl"
                        android:background="#ffffffff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:baselineAligned="false"/>
                    <TextView
                        android:textSize="@dimen/_14ssp"
                        android:textColor="#ff071219"
                        android:ellipsize="end"
                        android:id="@+id/selectedVehicleClassTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="@string/selected_following_learner_class"
                        android:maxLines="2"
                        android:fontFamily="@font/roboto_medium"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/selectedVehicleClassLl"
                        android:background="@drawable/circle_bg_corner_14_catskill_white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:baselineAligned="false"
                        android:backgroundTint="#ffffffff"
                        android:paddingVertical="@dimen/_10sdp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/rectangle_bg_white"
                        android:padding="@dimen/_10sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:baselineAligned="false">
                        <com.nic.mparivahan.dlservices.widget.MyTextView
                            android:textSize="@dimen/_13ssp"
                            android:textColor="@color/black"
                            android:id="@+id/tv_note_organ_donate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/willing_to_donate"
                            android:fontFamily="@font/roboto_medium"/>
                        <RadioGroup
                            android:orientation="horizontal"
                            android:id="@+id/willToDonateRg"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp">
                            <RadioButton
                                android:id="@+id/willing_to_donate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="@string/yes"/>
                            <RadioButton
                                android:id="@+id/not_willing_to_donate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/no"
                                android:layout_marginStart="@dimen/_20sdp"/>
                        </RadioGroup>
                        <androidx.appcompat.widget.AppCompatEditText
                            android:textSize="14sp"
                            android:id="@+id/org_mob_number"
                            android:background="@drawable/edit_text_style"
                            android:padding="10dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:hint="@string/emergency_contact"
                            android:maxLength="10"
                            android:inputType="number"
                            android:backgroundTint="#ffffffff"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:id="@+id/termCndRl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp">
                        <CheckBox
                            android:id="@+id/selfDeclartionCb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:layout_centerVertical="true"/>
                        <TextView
                            android:textSize="@dimen/_12ssp"
                            android:textColor="@color/black"
                            android:gravity="start"
                            android:id="@+id/selfDeclartionTv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/self_declartion"
                            android:maxLines="4"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/roboto_medium"
                            android:layout_toEndOf="@+id/selfDeclartionCb"/>
                    </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:baselineAligned="false">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/never_mix"
                        android:gravity="center"
                        android:id="@+id/cancelTv"
                        android:background="@drawable/button_white_theme"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_35sdp"
                        android:text="@string/cancel"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_5sdp"/>
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/nextTv"
                        android:background="@drawable/sign_in_new"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_35sdp"
                        android:text="@string/submit"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
