<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient
                        android:startColor="@color/light_gray"
                        android:endColor="@color/light_gray"
                        android:angle="90"
                        android:type="linear"/>
                    <corners android:radius="10dp"/>
                    <margin android:left="5dp"/>
                    <padding
                        android:left="3dp"
                        android:top="3dp"
                        android:right="0dp"
                        android:bottom="3dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
