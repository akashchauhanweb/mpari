<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linear_parent"
        android:background="@drawable/nexgen_carview_myrc_boarder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="3dp">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/nexgenshape"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:weightSum="5">
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="#ff071219"
                android:gravity="center_vertical"
                android:id="@+id/rc_number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:layout_weight="5"
                android:fontFamily="@font/nexgenttf"/>
            <LinearLayout
                android:gravity="center"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/nexgenttf">
                <ImageView
                    android:id="@+id/update"
                    android:background="@drawable/refresh_nexgen"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/nexgenttf">
                <ImageView
                    android:id="@+id/delet"
                    android:background="@drawable/delet_nexgen"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="@font/nexgenttf">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/option_menu"
                    android:layout_width="27dp"
                    android:layout_height="20dp"
                    android:src="@drawable/opt_menu"
                    android:scaleType="fitCenter"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="10dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#ff5a5a5a"
                android:id="@+id/shared_to"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shared To"
                android:fontFamily="@font/poopy"/>
            <TextView
                android:textSize="13dp"
                android:textStyle="normal"
                android:textColor="#ff071219"
                android:id="@+id/owner_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:fontFamily="@font/poopy"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#ff071219"
                android:id="@+id/mobile_number_tx"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:fontFamily="@font/poppins_regular"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ff5a5a5a"
                android:id="@+id/mobile_number"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=" 9411450607"
                android:fontFamily="@font/nexgenttf"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:weightSum="2">
                <TextView
                    android:textSize="11dp"
                    android:textColor="#ff353f45"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/issue_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="30dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/nexgenttf"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="#ff353f45"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/valid_upto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="30dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/nexgenttf"/>
            </LinearLayout>
            <TextView
                android:background="#ffebf2f5"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="10dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/shared_rc"
                android:background="@drawable/share_button_nexgen_shape"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="20dp"
                android:text="Share"
                android:fontFamily="@font/nexgenttf"/>
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
