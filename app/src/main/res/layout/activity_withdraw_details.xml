<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/sarathi_header"/>
    <androidx.core.widget.NestedScrollView
        android:background="@drawable/mvvm_linear"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include3">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17sp"
                android:textColor="@color/firefly"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/topTitleTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/withdraw_services"
                android:maxLines="1"
                android:fontFamily="@font/poppins_semi_bold"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.nic.mparivahan.MyTextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/oslo_grey"
                android:id="@+id/myApplicationNoTl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/application_no"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toStartOf="@+id/applicationNo"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/topTitleTv"/>
            <com.nic.mparivahan.MyTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="end"
                android:id="@+id/applicationNo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:text="@string/application_no"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/myApplicationNoTl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/myApplicationNoTl"
                app:layout_constraintTop_toTopOf="@+id/myApplicationNoTl"/>
            <com.nic.mparivahan.MyTextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/oslo_grey"
                android:id="@+id/applicantNameTl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/applicant_name"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toStartOf="@+id/applicantName"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/myApplicationNoTl"/>
            <com.nic.mparivahan.MyTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="end"
                android:id="@+id/applicantName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:text="@string/applicant_name"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/applicantNameTl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/applicantNameTl"
                app:layout_constraintTop_toTopOf="@+id/applicantNameTl"/>
            <com.nic.mparivahan.MyTextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/oslo_grey"
                android:id="@+id/applicationDateTl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/application_date"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toStartOf="@+id/applicationDate"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/applicantNameTl"/>
            <com.nic.mparivahan.MyTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="end"
                android:id="@+id/applicationDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:text="@string/application_date"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/applicationDateTl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/applicationDateTl"
                app:layout_constraintTop_toTopOf="@+id/applicationDateTl"/>
            <com.nic.mparivahan.MyTextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/oslo_grey"
                android:id="@+id/stateNameTl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/state_name"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toStartOf="@+id/stateName"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/applicationDateTl"/>
            <com.nic.mparivahan.MyTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="end"
                android:id="@+id/stateName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:text="@string/state_name"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/stateNameTl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/stateNameTl"
                app:layout_constraintTop_toTopOf="@+id/stateNameTl"/>
            <com.nic.mparivahan.MyTextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/oslo_grey"
                android:id="@+id/rtoNameTl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/rto_name_2"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toStartOf="@+id/rtoName"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stateNameTl"/>
            <com.nic.mparivahan.MyTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="end"
                android:id="@+id/rtoName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:text="@string/rto_name_2"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/rtoNameTl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/rtoNameTl"
                app:layout_constraintTop_toTopOf="@+id/rtoNameTl"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="15sp"
                android:textColor="@color/firefly"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/trans_applied_TitleTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="16dp"
                android:text="@string/transaction_s_applied"
                android:maxLines="1"
                android:fontFamily="@font/poppins_semi_bold"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rtoNameTl"/>
            <com.nic.mparivahan.MyTextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/transNameTl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/transaction_name"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/trans_applied_TitleTv"/>
            <com.nic.mparivahan.MyTextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="end"
                android:id="@+id/reason_remarkTl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:text="@string/reason_remarks"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/transNameTl"/>
            <CheckBox
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/oslo_grey"
                android:id="@+id/check_duplDL"
                android:padding="@dimen/_3sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/duplicate_dl_2"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toStartOf="@+id/spinner_duplDL"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/transNameTl"/>
            <CheckBox
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/oslo_grey"
                android:id="@+id/check_renewalDL"
                android:padding="@dimen/_3sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:text="@string/renewal_of_dl_2"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toStartOf="@+id/spinner_renewalDL"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/check_duplDL"/>
            <androidx.appcompat.widget.AppCompatSpinner
                android:entries="@array/dl_data"
                android:id="@+id/spinner_duplDL"
                android:background="@drawable/spinner_background_view"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="32dp"
                android:layout_marginRight="16dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/check_duplDL"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/check_duplDL"
                app:layout_constraintTop_toTopOf="@+id/check_duplDL"/>
            <androidx.appcompat.widget.AppCompatSpinner
                android:entries="@array/dl_data"
                android:id="@+id/spinner_renewalDL"
                android:background="@drawable/spinner_background_view"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="32dp"
                android:layout_marginRight="16dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/check_renewalDL"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/check_renewalDL"
                app:layout_constraintTop_toTopOf="@+id/check_renewalDL"/>
            <CheckBox
                android:textSize="13sp"
                android:textStyle="bold"
                android:id="@+id/checkBox"
                android:padding="@dimen/_5sdp"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/agree_terms_cond_new"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/check_renewalDL"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/withDrawTv"
                android:background="@drawable/corner_rectangle_bg_17"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/withdraw"
                android:maxLines="1"
                android:fontFamily="@font/robot_bold"
                android:layout_marginStart="16dp"
                android:paddingVertical="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/cancelTv"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/checkBox"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/cancelTv"
                android:background="@drawable/corner_rectangle_bg_17"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/cancel"
                android:maxLines="1"
                android:fontFamily="@font/robot_bold"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:paddingVertical="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/withDrawTv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/withDrawTv"
                app:layout_constraintTop_toTopOf="@+id/withDrawTv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
