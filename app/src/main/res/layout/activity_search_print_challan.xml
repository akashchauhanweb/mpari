<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <include
        android:id="@+id/header"
        layout="@layout/vahan_echallan_header"/>
    <ScrollView
        android:background="@drawable/mvvm_linear"
        android:fitsSystemWindows="true"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_10sdp"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:layout_marginHorizontal="16dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="18sp"
                android:textColor="@color/firefly"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/titleTv"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/echallan_print_challan"
                android:maxLines="1"
                android:fontFamily="@font/poppins_semi_bold"/>
            <LinearLayout
                android:id="@+id/challanNoLl"
                android:background="@drawable/corner_circle_bg_14"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="16dp">
                <RadioButton
                    android:textSize="14sp"
                    android:textColor="@color/firefly"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/challanNoRb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:checked="false"
                    android:text="@string/echallan_challan_number"
                    android:layout_marginStart="20dp"
                    android:paddingHorizontal="20dp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/vehicleNoLl"
                android:background="@drawable/corner_circle_14_selected"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp">
                <RadioButton
                    android:textSize="14sp"
                    android:textColor="@color/firefly"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/vehicleNoRb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:checked="true"
                    android:text="@string/echallan_vehicle_number"
                    android:layout_marginStart="20dp"
                    android:paddingHorizontal="20dp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/drivingLicenseLl"
                android:background="@drawable/corner_circle_bg_14"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp">
                <RadioButton
                    android:textSize="14sp"
                    android:textColor="@color/firefly"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/dLNoRb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:checked="false"
                    android:text="@string/echallan_driving_licence_number"
                    android:layout_marginStart="20dp"
                    android:paddingHorizontal="20dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/virtualrc_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp">
                <com.nic.mparivahan.MyTextView
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tv_my_vehicle_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:text="My Vehicle(s)"
                    style="@style/TextAppearance.AppCompat.Body2"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rec_rc_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/virtual_dl_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.nic.mparivahan.MyTextView
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/myDlLicence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:text="My Driving Licence"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/linear_parent"
                    android:background="@drawable/alert_shape"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="10dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/inner_parent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:weightSum="5">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:weightSum="6">
                                    <TextView
                                        android:textSize="14dp"
                                        android:textStyle="bold"
                                        android:textColor="#ff5a5a5a"
                                        android:gravity="center_vertical"
                                        android:id="@+id/tv_vehicle_no"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:layout_marginRight="10dp"
                                        android:text="Driving Licence No"
                                        android:layout_weight="5"
                                        android:fontFamily="@font/nexgenttf"/>
                                    <LinearLayout
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:id="@+id/delet_icon"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1">
                                        <ImageView
                                            android:background="@drawable/delet_icon_dl"
                                            android:visibility="gone"
                                            android:layout_width="21dp"
                                            android:layout_height="25dp"/>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:weightSum="2">
                                <TextView
                                    android:textSize="14dp"
                                    android:textStyle="bold"
                                    android:textColor="#ff071219"
                                    android:gravity="center_vertical"
                                    android:id="@+id/rc_number"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginTop="5dp"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/nexgenttf"/>
                                <TextView
                                    android:textSize="14dp"
                                    android:textStyle="bold"
                                    android:textColor="#ff09aeff"
                                    android:gravity="center"
                                    android:id="@+id/viewdetails"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="5dp"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginRight="5dp"
                                    android:text="View Challan"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/lato"/>
                            </LinearLayout>
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
            <EditText
                android:textSize="14sp"
                android:textColorHint="#ffaab7bf"
                android:id="@+id/inputEt"
                android:background="@drawable/circle_bg_corner_14_catskill_white"
                android:paddingLeft="10dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="16dp"
                android:hint="@string/enter_vehicle_number"
                android:cursorVisible="true"
                android:maxLines="1"
                android:maxLength="30"
                android:inputType="textCapWords"
                android:imeOptions="actionDone"
                android:fontFamily="@font/lato"
                android:importantForAutofill="no"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/vehicleDetailsLl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_chassi_no"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chassis No. (Enter last five digits)"
                    android:fontFamily="@font/poppins_regular"
                    android:paddingStart="5dp"/>
                <EditText
                    android:textSize="14sp"
                    android:textColorHint="#ffaab7bf"
                    android:id="@+id/chasisEt"
                    android:background="@drawable/circle_bg_corner_14_catskill_white"
                    android:paddingLeft="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="10dp"
                    android:hint="@string/echallan_enter_chassis_number"
                    android:cursorVisible="true"
                    android:maxLines="1"
                    android:maxLength="5"
                    android:inputType="textCapWords"
                    android:imeOptions="actionNext"
                    android:fontFamily="@font/lato"
                    android:importantForAutofill="no"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_engine_no"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Engine No. (Enter last five digits)"
                    android:fontFamily="@font/poppins_regular"
                    android:paddingStart="5dp"/>
                <EditText
                    android:textSize="14sp"
                    android:textColorHint="#ffaab7bf"
                    android:id="@+id/engineEt"
                    android:background="@drawable/circle_bg_corner_14_catskill_white"
                    android:paddingLeft="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="10dp"
                    android:hint="@string/echallan_enter_engine_number"
                    android:cursorVisible="true"
                    android:maxLines="1"
                    android:maxLength="5"
                    android:inputType="textCapWords"
                    android:imeOptions="actionDone"
                    android:fontFamily="@font/lato"
                    android:importantForAutofill="no"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/getDetailsTv"
                android:background="@drawable/corner_rectangle_bg_17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp"
                android:text="@string/get_details"
                android:maxLines="1"
                android:fontFamily="@font/lato"
                android:elevation="3dp"
                android:paddingVertical="16dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
