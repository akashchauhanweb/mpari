<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dashboard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="300dp"
    android:minHeight="150dp">
    <com.nic.mparivahan.MyTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/pop_up_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="25dp"
        android:layout_marginRight="20dp"
        android:text="You have chosen only 1 service &apos;&apos;Renewal Of DL&apos;&apos;"/>
    <com.nic.mparivahan.MyTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="20dp"
        android:text="Click Cancel to select more. "/>
    <com.nic.mparivahan.MyTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="10dp"
        android:text="Click Proceed to move ahead with current selection"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingBottom="50dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp">
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/submit_button"
            android:background="@drawable/red_gradient_background"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginRight="5dp"
            android:text="@string/cancel"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="@font/nexgenttf"
            android:layout_marginEnd="5dp"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="15dp"
            android:textColor="@color/white"
            android:id="@+id/reset_button"
            android:background="@drawable/blue_gradient_background"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginLeft="5dp"
            android:text="Proceed"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="@font/nexgenttf"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
</LinearLayout>
