<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/mvvm_header"/>
            <LinearLayout
                android:gravity="top|left"
                android:orientation="vertical"
                android:background="@drawable/mvvm_linear"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.nic.mparivahan.MyTextView
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/never_mix"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"/>
                        <LinearLayout
                            android:gravity="center"
                            android:padding="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cv_report_traffic_violation_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:cardBackgroundColor="@color/oslo_grey"
                                app:cardCornerRadius="20dp"
                                app:strokeColor="@color/oslo_grey"
                                app:strokeWidth="2dp">
                                <ImageView
                                    android:layout_gravity="center"
                                    android:id="@+id/iv_report_traffic_violation_icon"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    app:srcCompat="@drawable/user"/>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>
                    <com.nic.mparivahan.MyTextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Renewal Of DL"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="5dp">
                        <LinearLayout
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/sign_in_new"
                            android:padding="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="5dp"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_driving_license"
                                android:tint="@color/white"
                                app:tint="@color/white"/>
                            <com.nic.mparivahan.MyTextView
                                android:textSize="@dimen/new_normal_txt"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Driving License Details"
                                android:fontFamily="sans-serif-light"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/paytax"
                            android:padding="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="5dp"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/dms_docs"/>
                            <com.nic.mparivahan.MyTextView
                                android:textSize="@dimen/new_normal_txt"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="DMS \10(Upload Docs)"
                                android:fontFamily="sans-serif-light"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/paytax"
                            android:padding="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="5dp"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:srcCompat="@drawable/ic_fee_details"/>
                            <com.nic.mparivahan.MyTextView
                                android:textSize="@dimen/new_normal_txt"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Fee \10Details"
                                android:fontFamily="sans-serif-light"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:background="@drawable/edit_text_style"
                        android:paddingLeft="5dp"
                        android:paddingRight="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <androidx.appcompat.widget.AppCompatButton
                            android:textSize="12dp"
                            android:textColor="@color/black"
                            android:id="@+id/btn_my_vehicle"
                            android:background="@android:color/transparent"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:text="Detailed View"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:fontFamily="@font/nexgenttf"/>
                        <androidx.appcompat.widget.AppCompatButton
                            android:textSize="12dp"
                            android:textColor="@color/white"
                            android:id="@+id/btn_othe_vehicle"
                            android:background="@drawable/button_style"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:text="Card View"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:fontFamily="@font/nexgenttf"/>
                    </LinearLayout>
                    <com.nic.mparivahan.MyTextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Front"/>
                    <include layout="@layout/screen_14_dl_card"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/edit_text_style"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <androidx.appcompat.widget.AppCompatButton
                        android:textSize="12dp"
                        android:textColor="@color/white"
                        android:background="@drawable/button_style"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:text="@string/next"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:fontFamily="@font/nexgenttf"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
