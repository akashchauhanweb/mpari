<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1372a463"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:right="0dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dodger_blue"/>
            <corners android:radius="14dp"/>
            <gradient
                android:startColor="@color/dodger_blue"
                android:endColor="#ff06aaff"
                android:angle="270"/>
        </shape>
    </item>
</layer-list>
