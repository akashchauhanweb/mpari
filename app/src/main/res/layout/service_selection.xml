<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="325dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#ffeaedef"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/mvvm_back"
            android:padding="1dp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/mvvm_back"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_homee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/service_label"
                    android:paddingTop="@dimen/_2sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="DL Services"
                    android:maxLines="1"
                    android:layout_weight="1.4"
                    android:layout_toRightOf="@+id/mvvm_back"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/poppins_regular"
                    style="@style/TextAppearance.AppCompat.Body2"/>
                <TextView
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold"
                    android:textColor="@color/never_mix"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/service_label_dl"
                    android:paddingTop="@dimen/_2sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:maxLines="1"
                    android:layout_weight="1.4"
                    android:layout_toRightOf="@+id/mvvm_back"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/poppins_regular"
                    style="@style/TextAppearance.AppCompat.Body2"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:id="@+id/service_label_two"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="@dimen/_1sdp"
                android:text="REN, DUP, CA, Change in Name/DOB &amp; others"
                android:maxLines="1"
                android:layout_toRightOf="@+id/mvvm_back"
                android:layout_centerVertical="true"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginHorizontal="@dimen/_5sdp"
                style="@style/TextAppearance.AppCompat.Body2"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/cancelIv"
        android:visibility="gone"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_margin="5dp"
        android:src="@drawable/cross"
        android:scaleType="fitCenter"/>
    <com.nic.mparivahan.dlservices.widget.MyTextView
        android:textSize="5sp"
        android:textStyle="bold"
        android:textColor="@color/never_mix"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"/>
    <com.nic.mparivahan.dlservices.widget.MyTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/never_mix"
        android:gravity="center"
        android:id="@+id/dl_number_new"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:text="WB01 20010110681"
        android:fontFamily="@font/poppins_regular"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_style"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp">
        <com.nic.mparivahan.MyTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/select_Service_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="40dp"
            android:text="Select the service to apply"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/service_selection"
            android:padding="@dimen/_5sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_weight="0"/>
        <LinearLayout
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.nic.mparivahan.dlservices.widget.CustomWegetLayout
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/pop_up_reset"
                android:background="@drawable/sign_in_new"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:layout_weight="1"
                app:buttonText="@string/cancel"/>
            <com.nic.mparivahan.dlservices.widget.CustomWegetLayout
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/pop_up_proceed"
                android:background="@drawable/sign_in_new"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:layout_weight="1"
                app:buttonText="@string/Proceed"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
