<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_cov_list_0"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <include
        android:id="@+id/mHeader"
        layout="@layout/mvvm_header"/>
    <LinearLayout
        android:gravity="top|left"
        android:orientation="vertical"
        android:background="@drawable/mvvm_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/_10sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:baselineAligned="false">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/edit_text_style"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_1sdp"
                    android:backgroundTint="#fff1f6f8">
                    <TextView
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/selected_covs"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:gravity="center"
                        android:id="@+id/selected_covs"
                        android:background="@drawable/edit_text_style"
                        android:padding="@dimen/_10sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:maxLines="4"
                        android:backgroundTint="#ffffffff"
                        android:importantForAutofill="no"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/edit_text_style"
                    android:padding="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_16sdp"
                    android:baselineAligned="false"
                    android:backgroundTint="#fff1f6f8">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp">
                        <TextView
                            android:textSize="@dimen/_12ssp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:gravity="center_vertical"
                            android:id="@+id/txt_app_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/select_class_of_vehcile"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/selectLearnerClassLl"
                        android:background="#ffffffff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:baselineAligned="false"/>
                    <TextView
                        android:textSize="@dimen/_14ssp"
                        android:textColor="#ff071219"
                        android:ellipsize="end"
                        android:id="@+id/selectedVehicleClassTv"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="@string/selected_following_learner_class"
                        android:maxLines="2"
                        android:fontFamily="@font/roboto_medium"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/selectedVehicleClassLl"
                        android:background="@drawable/circle_bg_corner_14_catskill_white"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:baselineAligned="false"
                        android:backgroundTint="#ffffffff"
                        android:paddingVertical="@dimen/_10sdp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/applicantTrainedFromLl"
                        android:background="@drawable/rectangle_bg_white"
                        android:padding="@dimen/_10sdp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false">
                        <TextView
                            android:textSize="@dimen/_14ssp"
                            android:textColor="#ff071219"
                            android:ellipsize="end"
                            android:id="@+id/classOfVehicleForTrainingTv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:text="@string/class_of_vehicle_for_which_training_taken"
                            android:maxLines="2"
                            android:fontFamily="@font/roboto_medium"/>
                        <RelativeLayout
                            android:id="@+id/trainingVehicleSpinnerRl"
                            android:background="@drawable/edit_text_style"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:backgroundTint="#ffffffff">
                            <Spinner
                                android:id="@+id/trainingVehicleSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/_35sdp"
                                android:textAllCaps="true"/>
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/secondHolderLl"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false">
                            <RelativeLayout
                                android:id="@+id/stateWiseDrivingSchoolRl"
                                android:background="@color/white"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8sdp">
                                <CheckBox
                                    android:id="@+id/stateWiseDrivingSchoolCb"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="false"
                                    android:layout_centerVertical="true"/>
                                <TextView
                                    android:textSize="@dimen/_12ssp"
                                    android:textColor="@color/black"
                                    android:gravity="start"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/state_wise_driving_school"
                                    android:maxLines="2"
                                    android:layout_centerVertical="true"
                                    android:fontFamily="@font/roboto_medium"
                                    android:layout_toEndOf="@+id/stateWiseDrivingSchoolCb"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:id="@+id/drivingSchoolRl"
                                android:background="@drawable/edit_text_style"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8sdp"
                                android:backgroundTint="#ffffffff">
                                <Spinner
                                    android:id="@+id/drivingSchoolSpinner"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="@dimen/_35sdp"
                                    android:textAllCaps="true"/>
                            </RelativeLayout>
                            <LinearLayout
                                android:orientation="vertical"
                                android:id="@+id/enrollmentDetailsLl"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:baselineAligned="false">
                                <TextView
                                    android:textSize="@dimen/_12ssp"
                                    android:textColor="#ff071219"
                                    android:ellipsize="end"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/enrollment_no"
                                    android:maxLines="1"
                                    android:fontFamily="@font/roboto_medium"/>
                                <androidx.appcompat.widget.AppCompatEditText
                                    android:textSize="@dimen/_12ssp"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:id="@+id/enrollmentNoEt"
                                    android:background="@drawable/edit_text_style"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:hint="@string/enter_enrollment_no"
                                    android:maxLines="1"
                                    android:backgroundTint="#ffffffff"
                                    android:paddingHorizontal="@dimen/_10sdp"
                                    android:paddingVertical="@dimen/_12sdp"/>
                                <TextView
                                    android:textSize="@dimen/_12ssp"
                                    android:textColor="#ff071219"
                                    android:ellipsize="end"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:text="@string/enrollment_date"
                                    android:maxLines="1"
                                    android:fontFamily="@font/roboto_medium"/>
                                <androidx.appcompat.widget.AppCompatEditText
                                    android:textSize="@dimen/_12ssp"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:id="@+id/enrollmentDateEt"
                                    android:background="@drawable/edit_text_style"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:hint="@string/enter_enrollment_date"
                                    android:maxLines="1"
                                    android:backgroundTint="#ffffffff"
                                    android:paddingHorizontal="@dimen/_10sdp"
                                    android:paddingVertical="@dimen/_12sdp"/>
                                <TextView
                                    android:textSize="@dimen/_12ssp"
                                    android:textColor="#ff071219"
                                    android:ellipsize="end"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:text="@string/certificate_no"
                                    android:maxLines="1"
                                    android:fontFamily="@font/roboto_medium"/>
                                <androidx.appcompat.widget.AppCompatEditText
                                    android:textSize="@dimen/_12ssp"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:id="@+id/certificateNoEt"
                                    android:background="@drawable/edit_text_style"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:hint="@string/enter_certificate_number"
                                    android:maxLines="1"
                                    android:backgroundTint="#ffffffff"
                                    android:paddingHorizontal="@dimen/_10sdp"
                                    android:paddingVertical="@dimen/_12sdp"/>
                                <TextView
                                    android:textSize="@dimen/_12ssp"
                                    android:textColor="#ff071219"
                                    android:ellipsize="end"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:text="@string/certificate_date"
                                    android:maxLines="1"
                                    android:fontFamily="@font/roboto_medium"/>
                                <androidx.appcompat.widget.AppCompatEditText
                                    android:textSize="@dimen/_12ssp"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:id="@+id/certificateDateEt"
                                    android:background="@drawable/edit_text_style"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:hint="@string/enter_certificate_date"
                                    android:maxLines="1"
                                    android:backgroundTint="#ffffffff"
                                    android:paddingHorizontal="@dimen/_10sdp"
                                    android:paddingVertical="@dimen/_12sdp"/>
                                <TextView
                                    android:textSize="@dimen/_12ssp"
                                    android:textColor="#ff071219"
                                    android:ellipsize="end"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:text="@string/trained_from"
                                    android:maxLines="1"
                                    android:fontFamily="@font/roboto_medium"/>
                                <androidx.appcompat.widget.AppCompatEditText
                                    android:textSize="@dimen/_12ssp"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:id="@+id/trainedFromEt"
                                    android:background="@drawable/edit_text_style"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:hint="@string/enter_trained_from"
                                    android:maxLines="1"
                                    android:backgroundTint="#ffffffff"
                                    android:paddingHorizontal="@dimen/_10sdp"
                                    android:paddingVertical="@dimen/_12sdp"/>
                                <TextView
                                    android:textSize="@dimen/_12ssp"
                                    android:textColor="#ff071219"
                                    android:ellipsize="end"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:text="@string/trained_to"
                                    android:maxLines="1"
                                    android:fontFamily="@font/roboto_medium"/>
                                <androidx.appcompat.widget.AppCompatEditText
                                    android:textSize="@dimen/_12ssp"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:id="@+id/trainedToEt"
                                    android:background="@drawable/edit_text_style"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:hint="@string/enter_trained_to"
                                    android:maxLines="1"
                                    android:backgroundTint="#ffffffff"
                                    android:paddingHorizontal="@dimen/_10sdp"
                                    android:paddingVertical="@dimen/_12sdp"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/never_mix"
                                android:gravity="center"
                                android:id="@+id/addMoreBtn"
                                android:background="@drawable/button_white_theme"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_35sdp"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:text="@string/add_more"
                                android:layout_marginStart="@dimen/_5sdp"/>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/addedLearningDataRv"
                                android:background="#ffffffff"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_10sdp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/_13ssp"
                        android:textColor="#ff071219"
                        android:id="@+id/form1Tv"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:text="@string/fill_form_1"
                        android:fontFamily="@font/roboto_medium"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/disqualificationLl"
                        android:background="@drawable/rectangle_bg_white"
                        android:padding="@dimen/_10sdp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false">
                        <TextView
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@+id/dlNoTv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="@string/dl_no"/>
                        <EditText
                            android:textSize="14sp"
                            android:id="@+id/dlNoEt"
                            android:background="@drawable/edit_text_style"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:hint="@string/dl_no"
                            android:maxLines="2"
                            android:maxLength="18"
                            android:inputType="textCapCharacters"
                            android:backgroundTint="#ffffffff"
                            android:importantForAutofill="no"/>
                        <TextView
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@+id/issueDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="@string/issue_date_sarthi"/>
                        <TextView
                            android:textSize="14sp"
                            android:id="@+id/issueDateEt"
                            android:background="@drawable/edit_text_style"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:hint="DD-MM-YYYY"
                            android:maxLines="2"
                            android:backgroundTint="#ffffffff"/>
                        <TextView
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@+id/txtStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="@string/status"/>
                        <RelativeLayout
                            android:background="@drawable/edit_text_style"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:backgroundTint="#ffffffff">
                            <Spinner
                                android:id="@+id/statusSpn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/_35sdp"
                                android:textAllCaps="true"/>
                        </RelativeLayout>
                        <TextView
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@+id/fromDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="@string/from_date"/>
                        <TextView
                            android:textSize="14sp"
                            android:id="@+id/fromDateValue"
                            android:background="@drawable/edit_text_style"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:hint="DD-MM-YYYY"
                            android:maxLines="2"
                            android:backgroundTint="#ffffffff"/>
                        <TextView
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@+id/toDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="@string/to_date"/>
                        <TextView
                            android:textSize="14sp"
                            android:id="@+id/toDateValue"
                            android:background="@drawable/edit_text_style"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:hint="DD-MM-YYYY"
                            android:maxLines="2"
                            android:backgroundTint="#ffffffff"/>
                        <TextView
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@+id/issueAuthority"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="@string/issue_authority_ll"/>
                        <EditText
                            android:textSize="14sp"
                            android:id="@+id/issueAuthorityEt"
                            android:background="@drawable/edit_text_style"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:hint="@string/issue_authority"
                            android:maxLines="2"
                            android:inputType="textCapCharacters"
                            android:backgroundTint="#ffffffff"
                            android:importantForAutofill="no"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/rectangle_bg_white"
                        android:padding="@dimen/_10sdp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:baselineAligned="false">
                        <com.nic.mparivahan.dlservices.widget.MyTextView
                            android:textSize="@dimen/_13ssp"
                            android:textColor="@color/black"
                            android:id="@+id/tv_note_organ_donate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/willing_to_donate"
                            android:fontFamily="@font/roboto_medium"/>
                        <RadioGroup
                            android:orientation="horizontal"
                            android:id="@+id/willToDonateRg"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp">
                            <RadioButton
                                android:id="@+id/willing_to_donate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:text="@string/yes"/>
                            <RadioButton
                                android:id="@+id/not_willing_to_donate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/no"
                                android:layout_marginStart="@dimen/_20sdp"/>
                        </RadioGroup>
                        <androidx.appcompat.widget.AppCompatEditText
                            android:textSize="14sp"
                            android:id="@+id/org_mob_number"
                            android:background="@drawable/edit_text_style"
                            android:padding="10dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:hint="@string/emergency_contact"
                            android:maxLength="10"
                            android:inputType="number"
                            android:backgroundTint="#ffffffff"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp">
                        <CheckBox
                            android:id="@+id/selfDeclartionCb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:layout_centerVertical="true"/>
                        <TextView
                            android:textSize="@dimen/_12ssp"
                            android:textColor="@color/black"
                            android:gravity="start"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/self_declartion"
                            android:maxLines="4"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/roboto_medium"
                            android:layout_toEndOf="@+id/selfDeclartionCb"/>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:baselineAligned="false"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/never_mix"
            android:gravity="center"
            android:id="@+id/cancelTv"
            android:background="@drawable/button_white_theme"
            android:layout_width="0dp"
            android:layout_height="@dimen/_35sdp"
            android:text="@string/cancel"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_5sdp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/nextTv"
            android:background="@drawable/sign_in_new"
            android:layout_width="0dp"
            android:layout_height="@dimen/_35sdp"
            android:text="@string/submit"
            android:layout_weight="1"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
</RelativeLayout>
