<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/topHolder"
        layout="@layout/vahan_echallan_header"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_10sdp"
        android:fillViewport="true"
        android:layout_below="@+id/topHolder">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/mvvm_linear"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/topHolder">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/tabBarLl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:weightSum="3"
                android:layout_marginHorizontal="16dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/allTv"
                    android:background="@drawable/rectangle_bg_15_with_two_corner"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_55sdp"
                    android:text="@string/all"
                    android:maxLines="2"
                    android:lines="2"
                    android:layout_weight="1"
                    android:textAllCaps="true"
                    android:fontFamily="@font/robot_bold"
                    android:textAlignment="gravity"
                    android:paddingVertical="16dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="13sp"
                    android:textColor="#ff6b6b6b"
                    android:gravity="center"
                    android:id="@+id/pendingTv"
                    android:background="@drawable/rectanlge_without_corner_unselected"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_55sdp"
                    android:text="@string/pending_1"
                    android:maxLines="2"
                    android:lines="2"
                    android:layout_weight="1"
                    android:textAllCaps="true"
                    android:fontFamily="@font/robot_bold"
                    android:textAlignment="gravity"
                    android:paddingVertical="16dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="13sp"
                    android:textColor="#ff6b6b6b"
                    android:gravity="center"
                    android:id="@+id/disposeTv"
                    android:background="@drawable/rectangle_bg_two_corner_right"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_55sdp"
                    android:text="@string/dispose"
                    android:maxLines="2"
                    android:lines="2"
                    android:layout_weight="1"
                    android:textAllCaps="true"
                    android:fontFamily="@font/robot_bold"
                    android:textAlignment="gravity"
                    android:paddingVertical="16dp"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/firefly"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/totalChallanCountTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/total_challan"
                android:maxLines="1"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginHorizontal="16dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/noChallanFoundTv"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="@string/no_challan_found"
                android:fontFamily="@font/poppins_semi_bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/firefly"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/challanDetailsTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/challan_details_"
                android:maxLines="1"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginHorizontal="16dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/challanListRv"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/firefly"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/noticeDetailsTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/notice_details"
                android:maxLines="1"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginHorizontal="16dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/noticeListRv"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ProgressBar
        android:id="@+id/progressBar"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_centerInParent="true"/>
</RelativeLayout>
