<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="20dp"
    android:layout_marginTop="20dp"
    android:layout_marginRight="20dp"
    android:elevation="2dp"
    app:cardCornerRadius="15dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="20dp"
        android:layout_centerInParent="true">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <RelativeLayout
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:minHeight="120dp">
                <TextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/mainTextColor"
                    android:id="@+id/head"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="70dp"
                    android:text="@string/verify_your_dl"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="@font/nexgenttf"/>
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray"
                    android:gravity="center"
                    android:id="@+id/enter_the_dl_details_verify"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/enter_the_details"
                    android:layout_below="@+id/head"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="@font/nexgenttf"/>
            </RelativeLayout>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/calendar"/>
        </FrameLayout>
        <LinearLayout
            android:id="@+id/e_kyc_container_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:id="@+id/e_kyc_aadhaar_container"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@color/white"
                        android:paddingLeft="0dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false">
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:id="@+id/dob_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginBottom="5dp"
                                android:text="@string/enter_dob"
                                android:fontFamily="@font/nexgenttf"
                                style="@style/TextAppearance.AppCompat.Body2"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:background="@drawable/sign_in_back"
                                android:padding="5dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:weightSum="1">
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="5dp"
                                    android:layout_marginRight="10dp"
                                    android:weightSum="1"
                                    android:layout_weight="0.9">
                                    <EditText
                                        android:textSize="14sp"
                                        android:textColor="@color/text_color"
                                        android:gravity="center"
                                        android:id="@+id/applicant_date"
                                        android:focusable="true"
                                        android:layout_width="45dp"
                                        android:layout_height="45dp"
                                        android:hint="@string/dd"
                                        android:maxLength="2"
                                        android:digits=" 0123456789"
                                        android:inputType="number"
                                        android:backgroundTint="@color/light_gray"/>
                                    <TextView
                                        android:gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:text="-"/>
                                    <EditText
                                        android:textSize="14sp"
                                        android:textColor="@color/text_color"
                                        android:gravity="center_vertical"
                                        android:id="@+id/applicant_month"
                                        android:focusable="true"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:hint="@string/mm"
                                        android:maxLength="2"
                                        android:digits=" 0123456789"
                                        android:inputType="number"
                                        android:backgroundTint="@color/light_gray"/>
                                    <TextView
                                        android:gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:text="-"/>
                                    <EditText
                                        android:textSize="14sp"
                                        android:textColor="@color/text_color"
                                        android:gravity="center"
                                        android:id="@+id/applicant_year"
                                        android:focusable="true"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:hint="@string/yyyy"
                                        android:maxLength="4"
                                        android:digits=" 0123456789"
                                        android:inputType="number"
                                        android:backgroundTint="@color/light_gray"/>
                                </LinearLayout>
                                <ImageView
                                    android:layout_gravity="center"
                                    android:id="@+id/dob_cal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/c21"/>
                                <EditText
                                    android:textSize="14sp"
                                    android:gravity="center_vertical"
                                    android:id="@+id/applicant_dob"
                                    android:padding="12dp"
                                    android:visibility="gone"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.9"
                                    android:inputType="none"
                                    android:backgroundTint="@color/white"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <androidx.cardview.widget.CardView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/cancel"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:elevation="4dp"
                app:cardBackgroundColor="@color/light_gray"
                app:cardCornerRadius="15dp">
                <TextView
                    android:textColor="@color/mainTextColor"
                    android:layout_gravity="center"
                    android:id="@+id/cancle_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="@string/cancel"/>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:id="@+id/verify_card"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:elevation="2dp"
                app:cardBackgroundColor="#ff23caff"
                app:cardCornerRadius="15dp">
                <TextView
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/verify_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="@string/verify_rc"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
