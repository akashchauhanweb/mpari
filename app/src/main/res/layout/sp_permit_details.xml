<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/sp_permit_details_0"
    android:background="@drawable/layerlistexample"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <include
        android:id="@+id/topHolder"
        layout="@layout/vahan_echallan_header"/>
    <ScrollView
        android:background="@drawable/mvvm_linear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_above="@+id/btnHolder"
        android:layout_below="@+id/topHolder">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_10sdp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="18sp"
                android:textColor="@color/firefly"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/topTitleTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/fill_special_permit_detail"
                android:maxLines="1"
                android:fontFamily="@font/poppins_semi_bold"/>
            <RelativeLayout
                android:id="@+id/paymentStatusRl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp">
                <CheckedTextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/firefly"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/routeLengthCb"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/route_length_detail"
                    android:maxLines="2"
                    android:minLines="2"
                    android:drawableTop="@drawable/custom_checkbox_permit"
                    android:layout_centerInParent="true"
                    android:textAlignment="gravity"/>
                <View
                    android:id="@+id/paymentView"
                    android:background="@color/geyser"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="15dp"
                    android:layout_toStartOf="@+id/routeLengthCb"
                    android:layout_toEndOf="@+id/basicDetailsCb"/>
                <CheckedTextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/firefly"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/basicDetailsCb"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/special_basic_detail"
                    android:maxLines="2"
                    android:minLines="2"
                    android:drawableTop="@drawable/custom_checkbox_permit"
                    android:layout_centerVertical="true"
                    android:textAlignment="gravity"
                    android:layout_alignParentStart="true"/>
                <View
                    android:id="@+id/receiptView"
                    android:background="@color/geyser"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="15dp"
                    android:layout_toStartOf="@+id/specialDetailCb"
                    android:layout_toEndOf="@+id/routeLengthCb"/>
                <CheckedTextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="#b3071219"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/specialDetailCb"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="@string/special_detail"
                    android:maxLines="2"
                    android:minLines="2"
                    android:drawableTop="@drawable/custom_checkbox_permit"
                    android:layout_centerVertical="true"
                    android:textAlignment="gravity"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11sp"
                android:textColor="@color/red_new"
                android:id="@+id/txt_instruction"
                android:background="@drawable/red_edit_text_style"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="@string/leave_section"
                android:fontFamily="@font/poppins_regular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/routeLengthTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_18sdp"
                android:text="@string/route_length"
                android:fontFamily="@font/nexgenttf"
                app:fontFamily="@font/poppins_semi_bold"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="@color/text_color"
                android:gravity="center_vertical"
                android:id="@+id/routeLengthValue"
                android:background="@drawable/edit_text_style"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:hint="@string/route_length"
                android:maxLines="1"
                android:inputType="number"
                android:textAlignment="gravity"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/serviceTypeTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/camp_service_type_txt"
                android:fontFamily="@font/nexgenttf"
                app:fontFamily="@font/poppins_semi_bold"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp">
                <Spinner
                    android:id="@+id/serviceTypeSpn"
                    android:background="@drawable/edit_text_style"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:spinnerMode="dialog"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="40dp"
                    android:paddingVertical="@dimen/_7sdp">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/rightReasonPin"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:src="@drawable/down_arrow"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/btnHolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_7sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:layout_alignParentBottom="true">
        <com.nic.mparivahan.dlservices.widget.CustomWegetLayout
            android:id="@+id/reset"
            android:background="@drawable/button_white_theme"
            android:layout_width="0dp"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_5sdp"
            app:buttonText="@string/back"
            app:buttonTextColor="@color/never_mix"
            app:buttonTextSize="14sp"
            app:progressColor="#ffffffff"
            app:progressWidth="1dp"/>
        <com.nic.mparivahan.dlservices.widget.CustomWegetLayout
            android:id="@+id/id_next_service"
            android:background="@drawable/sign_in_new"
            android:layout_width="0dp"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_weight="1"
            app:buttonText="@string/next"
            app:buttonTextColor="@color/white"
            app:buttonTextSize="14sp"
            app:progressColor="#ffffffff"
            app:progressWidth="1dp"/>
    </LinearLayout>
</RelativeLayout>
