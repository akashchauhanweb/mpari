<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="350dp">
    <include
        android:visibility="gone"
        layout="@layout/mvvm_header"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.nic.mparivahan.dlservices.widget.MyTextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/never_mix"
                android:gravity="center"
                android:id="@+id/dl_number_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/poppins_regular"/>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/dl_no"
                android:background="@drawable/edit_text_style"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAllCaps="true"/>
            <com.nic.mparivahan.dlservices.widget.MyTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/txt_req_submit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/current_state"/>
            <RelativeLayout
                android:background="@drawable/edit_text_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp">
                <Spinner
                    android:id="@+id/current_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_35sdp"
                    android:textAllCaps="true"/>
            </RelativeLayout>
            <com.nic.mparivahan.dlservices.widget.MyTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/txt_req_submit_rto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/current_rto"/>
            <FrameLayout
                android:background="@drawable/edit_text_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp">
                <Spinner
                    android:id="@+id/current_rto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_35sdp"
                    android:textAllCaps="true"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:src="@drawable/a1"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.nic.mparivahan.dlservices.widget.CustomWegetLayout
                    android:gravity="center"
                    android:layout_gravity="bottom"
                    android:id="@+id/txt_service_cancel"
                    android:background="@drawable/shape_red"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_25sdp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    app:buttonText="@string/cancel"
                    app:buttonTextColor="@color/white"
                    app:buttonTextSize="12sp"
                    app:progressColor="#ffffffff"
                    app:progressWidth="1dp"/>
                <com.nic.mparivahan.dlservices.widget.CustomWegetLayout
                    android:gravity="center"
                    android:layout_gravity="bottom"
                    android:id="@+id/txt_service_submit"
                    android:background="@drawable/sign_in_new"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="@dimen/_25sdp"
                    android:layout_weight="1"
                    app:buttonText="@string/next"
                    app:buttonTextColor="@color/white"
                    app:buttonTextSize="12sp"
                    app:progressColor="#ffffffff"
                    app:progressWidth="1dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
