<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header_acc_feed"
        layout="@layout/mvvm_header"/>
    <androidx.cardview.widget.CardView
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="20dp"
        app:elevation="0dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="18dp"
                android:text="Name"/>
            <TextView
                android:textColor="@color/gray"
                android:id="@+id/ev_name"
                android:background="@drawable/edit_text_style"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="20dp"
                android:minHeight="50dp"
                android:textCursorDrawable="@color/blue"/>
            <TextView
                android:id="@+id/tv_email_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="18dp"
                android:text="Email ID"/>
            <TextView
                android:textColor="@color/gray"
                android:id="@+id/ev_email_id"
                android:background="@drawable/edit_text_style"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="20dp"
                android:minHeight="50dp"
                android:textCursorDrawable="@color/blue"/>
            <androidx.cardview.widget.CardView
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="25dp"
                android:layout_marginStart="23dp"
                android:layout_marginEnd="23dp"
                app:cardCornerRadius="10dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.appcompat.widget.AppCompatButton
                        android:textColor="@color/white"
                        android:background="@drawable/gradient_background"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="FeedBack"
                        android:layout_weight="1"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textColor="@color/black"
                        android:background="@color/white"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Incident"
                        android:layout_weight="1"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="23dp"
                        android:layout_marginTop="18dp"
                        android:text="Description ( Max 250 Characters )"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:hint="Enter feedback ( Minimum 30 Characters )"
                        android:layout_marginStart="23dp"
                        android:layout_marginEnd="23dp"
                        style="@style/CustomTextInputLayout">
                        <EditText
                            android:textColor="@color/gray"
                            android:gravity="start|top"
                            android:id="@+id/editTextTextMultiLine"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:maxLength="250"
                            android:inputType="textMultiLine"
                            android:imeOptions="actionDone"
                            android:focusedByDefault="true"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <ProgressBar
                    android:layout_gravity="top|center_horizontal"
                    android:id="@+id/traffic_feedback_progress"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_image"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="20dp">
                <ImageButton
                    android:id="@+id/ib_add_image"
                    android:background="@drawable/image_button_style"
                    android:padding="15dp"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="6dp"
                    app:srcCompat="@drawable/ic_photo_camera"/>
            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="23dp"
                android:layout_marginStart="23dp"
                android:layout_marginEnd="23dp"
                app:cardCornerRadius="10dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/btn_feedback"
                    android:background="@drawable/gradient_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Send Feedback"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
