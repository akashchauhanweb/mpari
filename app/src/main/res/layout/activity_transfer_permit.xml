<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/activity_transfer_permit_0"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <include
            android:id="@+id/topHolder"
            layout="@layout/vahan_echallan_header"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/mvvm_linear"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_5sdp"
            android:baselineAligned="false">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="5">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/never_mix"
                    android:gravity="center_vertical"
                    android:id="@+id/vehicleNumberTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/vehicle_no_dlyyxx0000"
                    android:layout_weight="2.7"
                    android:fontFamily="@font/robot_bold"
                    android:layout_marginHorizontal="@dimen/_16sdp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/never_mix"
                    android:gravity="center"
                    android:id="@+id/vehicle_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/view_vehicle_details"
                    android:maxLines="2"
                    android:layout_weight="2.3"
                    android:fontFamily="@font/robot_bold"
                    android:layout_marginHorizontal="@dimen/_16sdp"/>
            </LinearLayout>
            <com.nic.mparivahan.MyTextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/freshPermitTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="@string/fresh_permit"
                android:maxLines="1"
                android:layout_marginHorizontal="@dimen/_16sdp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp">
                    <com.nic.mparivahan.MyTextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/release_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/permit_no"/>
                    <com.nic.mparivahan.MyTextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/reject"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:layout_marginStart="3dp"/>
                </LinearLayout>
                <EditText
                    android:textSize="13sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/permitNoEt"
                    android:background="@drawable/edit_text_style"
                    android:padding="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:hint="@string/permit_no"
                    android:maxLength="25"
                    android:digits="qwertyuioplkjhgfdsazxcvbnmAQWERTYUIOPLKJHGFDSAZXCVBNM1234567890-. "
                    android:inputType="textCapCharacters"
                    android:layout_marginHorizontal="@dimen/_16sdp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp">
                    <com.nic.mparivahan.MyTextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/validFromTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valid_from"/>
                    <com.nic.mparivahan.MyTextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/reject"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:layout_marginStart="3dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColorHint="@color/dl_service_color"
                    android:gravity="center_vertical"
                    android:id="@+id/validFromValueTv"
                    android:background="@drawable/edit_text_style"
                    android:padding="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/valid_from"
                    android:layout_marginHorizontal="@dimen/_16sdp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp">
                    <com.nic.mparivahan.MyTextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/validUptoTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valid_upto_v2"/>
                    <com.nic.mparivahan.MyTextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/reject"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:layout_marginStart="3dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColorHint="@color/dl_service_color"
                    android:gravity="center_vertical"
                    android:id="@+id/validUptoValueTv"
                    android:background="@drawable/edit_text_style"
                    android:padding="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/valid_upto_v2"
                    android:layout_marginHorizontal="@dimen/_16sdp"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/btnSubmit"
                android:background="@drawable/button_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/get_permit_detail"
                android:textAllCaps="false"
                android:fontFamily="@font/nexgenttf"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginVertical="@dimen/_30sdp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
