<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/submit_tv"
    android:tag="layout/activity_dl_status_details_0"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header_layout"
        layout="@layout/mvvm_header"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/mvvm_linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/app_status_title"
            app:layout_constraintStart_toEndOf="@+id/app_status_title">
            <com.nic.mparivahan.MyTextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/app_status_title"
                android:padding="@dimen/_10sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="16dp"
                android:text="Application Status"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/dl_app_status_request_tv"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="Request for"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toStartOf="@+id/app_status_title"
                app:layout_constraintTop_toBottomOf="@+id/app_status_title"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/renewal_dl"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_13sdp"
                android:layout_marginRight="16dp"
                android:text="Renewal of DL"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/dl_app_status_request_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/dl_app_status_request_tv"/>
            <TextView
                android:id="@+id/dl_status"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:text="Status"
                app:layout_constraintStart_toStartOf="@+id/dl_app_status_request_tv"
                app:layout_constraintTop_toBottomOf="@+id/dl_app_status_request_tv"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/dl_status_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginRight="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/dl_status"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/dl_status"/>
            <TextView
                android:id="@+id/dl_app_no"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:text="Application No."
                app:layout_constraintStart_toStartOf="@+id/dl_status"
                app:layout_constraintTop_toBottomOf="@+id/dl_status"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/dl_app_no_tv"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginRight="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/dl_app_no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/dl_app_no"/>
            <TextView
                android:id="@+id/dl_name"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:text="Name"
                app:layout_constraintStart_toStartOf="@+id/dl_app_no"
                app:layout_constraintTop_toBottomOf="@+id/dl_app_no"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/dl_name_tv"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginRight="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/dl_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/dl_name"/>
            <TextView
                android:id="@+id/dl_s_d_w"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_13sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:text="Son / Daughter / Wife of"
                app:layout_constraintStart_toStartOf="@+id/dl_name"
                app:layout_constraintTop_toBottomOf="@+id/dl_name"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/dl_s_d_w_tv"
                android:tag="binding_3"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginRight="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/dl_s_d_w"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/dl_s_d_w"/>
            <TextView
                android:id="@+id/dl_dob"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:text="Date of Birth"
                app:layout_constraintStart_toStartOf="@+id/dl_s_d_w"
                app:layout_constraintTop_toBottomOf="@+id/dl_s_d_w"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/dl_dob_tv"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginRight="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/dl_dob"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/dl_dob"/>
            <TextView
                android:id="@+id/dl_rto_name"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="@dimen/_13sdp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="@dimen/_7sdp"
                android:text="RTO Name"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dl_dob"/>
            <TextView
                android:textStyle="bold"
                android:gravity="right"
                android:id="@+id/dl_rto_name_tv"
                android:tag="binding_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toEndOf="@+id/dl_rto_name"
                app:layout_constraintTop_toTopOf="@+id/dl_rto_name"/>
            <View
                android:id="@+id/view3"
                android:background="@color/light_gray"
                android:layout_width="0dp"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginTop="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dl_rto_name_tv"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/dl_status_label"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:text="Status"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view3"/>
            <TextView
                android:id="@+id/dl_status_renewal_tv"
                android:tag="binding_6"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_marginRight="32dp"
                android:layout_marginEnd="32dp"
                app:layout_constraintEnd_toStartOf="@+id/refresh_status"
                app:layout_constraintStart_toStartOf="@+id/dl_status_label"
                app:layout_constraintTop_toBottomOf="@+id/dl_status_label"/>
            <ImageView
                android:id="@+id/refresh_status"
                android:background="@drawable/refresh_button"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                app:layout_constraintBottom_toBottomOf="@+id/dl_status_renewal_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.98"
                app:layout_constraintStart_toEndOf="@+id/dl_status_label"
                app:layout_constraintTop_toTopOf="@+id/dl_status_label"/>
            <ProgressBar
                android:id="@+id/refresh_status_pb"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/refresh_status"
                app:layout_constraintEnd_toEndOf="@+id/refresh_status"
                app:layout_constraintStart_toStartOf="@+id/refresh_status"
                app:layout_constraintTop_toTopOf="@+id/refresh_status"
                style="?android:attr/progressBarStyle"/>
            <View
                android:id="@+id/view4"
                android:background="@color/light_gray"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginTop="@dimen/_15sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dl_status_renewal_tv"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/dl_stages_to_compeleted_label"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:text="Stage(s) to be completed"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view4"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dl_stages_rv"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_marginRight="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/dl_stages_to_compeleted_label"
                app:layout_constraintTop_toBottomOf="@+id/dl_stages_to_compeleted_label"/>
            <View
                android:id="@+id/view5"
                android:background="@color/light_gray"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginTop="@dimen/_15sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dl_stages_rv"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/dl_note_label"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:text="Note"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view5"/>
            <TextView
                android:id="@+id/dl_note_tv"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_marginRight="16dp"
                android:text="Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry&apos;s standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting, remaining essentially unchanged. It was popularised in the 1960s with the release of Letraset sheets containing Lorem Ipsum passages, and more recently with desktop publishing software like Aldus PageMaker including versions of Lorem Ipsum. Why do we use it? It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout. The point of using Lorem Ipsum is that it has a more-or-less normal distribution of letters, as opposed to using &apos;Content here, content here&apos;, making it look like readable English. Many desktop publishing packages and web page editors now use Lorem Ipsum as their default model text, and a search for &apos;lorem ipsum&apos; will uncover many web sites still in their infancy. Various versions have evolved over the years, sometimes by accident, sometimes on purpose (injected humour and the like)."
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dl_note_label"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/done"
                android:background="@drawable/sign_in_new"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dl_note_tv">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Done"
                    android:fontFamily="sans-serif-light"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
