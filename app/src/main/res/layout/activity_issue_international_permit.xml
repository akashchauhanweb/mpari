<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_issue_international_permit_0"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/header_layout"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/multi_head"
            android:visibility="gone"
            layout="@layout/multiheader"/>
        <include
            android:id="@+id/mHeader"
            android:visibility="visible"
            layout="@layout/mvvm_header"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="top|left"
        android:orientation="vertical"
        android:background="@drawable/mvvm_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-2dp"
        android:layout_below="@+id/header_layout">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_12sdp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/never_mix"
                        android:gravity="center"
                        android:id="@+id/dl_no_txt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/never_mix"
                        android:gravity="center"
                        android:id="@+id/txt_view_details"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_5sdp"
                        android:text="@string/view_dl_details"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_10sdp">
                    <com.nic.mparivahan.dlservices.widget.MyTextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/select_service"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="International Driving Permit"
                        android:fontFamily="@font/poppins_regular"/>
                    <LinearLayout
                        android:gravity="center"
                        android:padding="1dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:id="@+id/icon_image"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginLeft="20dp"
                            android:layout_centerHorizontal="true"
                            app:cardCornerRadius="30dp">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/avtar_icon"/>
                        </androidx.cardview.widget.CardView>
                        <androidx.cardview.widget.CardView
                            android:id="@+id/round_card_view"
                            android:visibility="visible"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginLeft="0dp"
                            android:layout_centerHorizontal="true"
                            app:cardCornerRadius="30dp">
                            <ImageView
                                android:id="@+id/iv_report_traffic_violation_icon"
                                android:layout_width="50dp"
                                android:layout_height="50dp"/>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:tag="binding_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginRight="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_8sdp">
                    <include
                        android:id="@+id/psl"
                        layout="@layout/idp_signature_link"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/multi_steps"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"/>
                <com.nic.mparivahan.dlservices.widget.MyTextView
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/black"
                    android:id="@+id/txtAppCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/app_category"
                    android:fontFamily="@font/roboto_medium"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">
                    <Spinner
                        android:id="@+id/spn_app_cat"
                        android:background="@drawable/edit_text_style"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/_35sdp"
                        android:textAllCaps="true"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:padding="@dimen/_5sdp"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginRight="@dimen/_5sdp"
                        android:src="@drawable/a1"/>
                </FrameLayout>
                <com.nic.mparivahan.dlservices.widget.MyTextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/black"
                    android:id="@+id/idpRto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="@string/rto"
                    android:fontFamily="@font/roboto_medium"/>
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:gravity="center"
                    android:id="@+id/id_rto"
                    android:background="@drawable/edit_text_style"
                    android:paddingLeft="@dimen/_5sdp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_5sdp"/>
                <com.nic.mparivahan.dlservices.widget.MyTextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_birth_place"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/birth_place"
                    android:fontFamily="@font/roboto_medium"/>
                <EditText
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/txt_color_address"
                    android:id="@+id/idp_birth_place"
                    android:tag="binding_3"
                    android:background="@drawable/edit_text_style"
                    android:paddingLeft="@dimen/_5sdp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:hint="Enter your birth place"
                    android:maxLines="1"
                    android:maxLength="20"
                    android:digits=" ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 "
                    android:inputType="textCapCharacters"
                    android:paddingStart="@dimen/_5sdp"/>
                <com.nic.mparivahan.dlservices.widget.MyTextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_birth_country"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="@string/birth_country"
                    android:fontFamily="@font/roboto_medium"/>
                <EditText
                    android:textSize="@dimen/_12sdp"
                    android:id="@+id/id_iidp_birthCountry"
                    android:tag="binding_4"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:hint="Select Country"
                    android:layout_marginEnd="@dimen/_5sdp"
                    style="@style/SpinnerEditText"/>
                <com.nic.mparivahan.dlservices.widget.MyTextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_passport_no"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="@string/passport_no"
                    android:fontFamily="@font/roboto_medium"/>
                <EditText
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/txt_color_address"
                    android:id="@+id/passport_et"
                    android:tag="binding_5"
                    android:background="@drawable/edit_text_style"
                    android:paddingLeft="@dimen/_5sdp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:hint="Enter your passport no."
                    android:maxLines="1"
                    android:maxLength="15"
                    android:inputType="textCapCharacters"
                    android:paddingStart="@dimen/_5sdp"/>
                <com.nic.mparivahan.dlservices.widget.MyTextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_valid_upto"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="@string/pass_valid_to"
                    android:fontFamily="@font/roboto_medium"/>
                <EditText
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/txt_color_address"
                    android:id="@+id/possport_valid_date"
                    android:tag="binding_6"
                    android:background="@drawable/edit_text_style"
                    android:paddingLeft="@dimen/_5sdp"
                    android:paddingRight="@dimen/_10sdp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:hint="Select your passport validity"
                    android:maxLines="1"
                    android:drawableRight="@drawable/ic_calendar"
                    android:inputType="textCapCharacters"
                    android:paddingStart="@dimen/_5sdp"
                    android:paddingEnd="@dimen/_10sdp"/>
                <com.nic.mparivahan.dlservices.widget.MyTextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_note_disqualified_dl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/txt_issue_international_disquilified_for_dl"
                    android:fontFamily="@font/roboto_medium"/>
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/iidp_yesNoType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <RadioButton
                        android:textSize="@dimen/_10sdp"
                        android:id="@+id/iidp_yes"
                        android:tag="binding_7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/yes"
                        android:fontFamily="@font/roboto_medium"/>
                    <RadioButton
                        android:textSize="@dimen/_10sdp"
                        android:id="@+id/iidp_no"
                        android:tag="binding_8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_120sdp"
                        android:text="@string/no"
                        android:fontFamily="@font/roboto_medium"/>
                </RadioGroup>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="@dimen/_11sdp"
                    android:gravity="top|left"
                    android:id="@+id/id_disqualify_et"
                    android:background="@drawable/edit_text_style"
                    android:padding="@dimen/_10sdp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:hint="@string/if_so_what_reason"
                    android:inputType="textCapCharacters"
                    android:backgroundTint="#ffebf2f5"/>
                <com.nic.mparivahan.dlservices.widget.MyTextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_note_barred_curr_country"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/txt_iidp_reasonSecond"
                    android:fontFamily="@font/roboto_medium"/>
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/iidp_yesNoTypeSecond"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <RadioButton
                        android:textSize="@dimen/_10sdp"
                        android:id="@+id/iidp_yes_second"
                        android:tag="binding_9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/yes"
                        android:fontFamily="@font/roboto_medium"/>
                    <RadioButton
                        android:textSize="@dimen/_10sdp"
                        android:id="@+id/iidp_no_second"
                        android:tag="binding_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_120sdp"
                        android:text="@string/no"
                        android:fontFamily="@font/roboto_medium"/>
                </RadioGroup>
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="@dimen/_11sdp"
                    android:id="@+id/id_iidp_barred"
                    android:background="@drawable/edit_text_style"
                    android:padding="@dimen/_10sdp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:hint="@string/if_so_what_reason"
                    android:inputType="textCapCharacters"
                    android:backgroundTint="#ffebf2f5"/>
                <com.nic.mparivahan.dlservices.widget.MyTextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_count_visa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:text="@string/country_for_which_visa_is_granted"
                    android:fontFamily="@font/roboto_medium"/>
                <EditText
                    android:textSize="@dimen/_12sdp"
                    android:id="@+id/id_iidp_visaCountry"
                    android:tag="binding_11"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:hint="Select country"
                    android:layout_marginEnd="@dimen/_5sdp"
                    style="@style/SpinnerEditText"/>
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textStyle="italic"
                    android:textColor="@color/never_mix"
                    android:id="@+id/id_iidp_restricteCountry"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:text="@string/click_here_to_view_the_list_of_restricted_countries"
                    android:layout_marginEnd="@dimen/_5sdp"/>
                <com.nic.mparivahan.dlservices.widget.MyTextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_visa_no"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="Visa No."
                    android:fontFamily="@font/roboto_medium"/>
                <EditText
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/txt_color_address"
                    android:ellipsize="end"
                    android:id="@+id/visa_et"
                    android:tag="binding_12"
                    android:background="@drawable/edit_text_style"
                    android:paddingLeft="@dimen/_5sdp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:hint="Enter your visa no."
                    android:maxLines="1"
                    android:maxLength="25"
                    android:inputType="textCapCharacters"
                    android:paddingStart="@dimen/_5sdp"/>
                <com.nic.mparivahan.dlservices.widget.MyTextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_visa_valid_upto"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="Valid Upto"
                    android:fontFamily="@font/roboto_medium"/>
                <EditText
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/txt_color_address"
                    android:ellipsize="end"
                    android:id="@+id/visa_validate_date"
                    android:tag="binding_13"
                    android:background="@drawable/edit_text_style"
                    android:paddingLeft="@dimen/_5sdp"
                    android:paddingRight="@dimen/_10sdp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:hint="Select your visa validity"
                    android:maxLines="1"
                    android:drawableRight="@drawable/ic_calendar"
                    android:paddingStart="@dimen/_5sdp"
                    android:paddingEnd="@dimen/_10sdp"/>
                <com.nic.mparivahan.dlservices.widget.MyTextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_cov_grades_idp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/cov_grades_for_which_idp_is_requested"
                    android:fontFamily="@font/roboto_medium"/>
                <EditText
                    android:textSize="@dimen/_12sdp"
                    android:id="@+id/id_iidp_cov_grades"
                    android:tag="binding_14"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:hint="Select COV Grades"
                    android:layout_marginEnd="@dimen/_5sdp"
                    style="@style/SpinnerEditText"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/formIndianEmbassyLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp">
                    <CheckBox
                        android:id="@+id/formIndianEmbassy"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:text="I am from Indian Embassy"/>
                    <com.nic.mparivahan.dlservices.widget.MyTextView
                        android:textSize="@dimen/_13sdp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_embassy_name"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:text="@string/ind_emm_name"
                        android:fontFamily="@font/roboto_medium"/>
                    <EditText
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@color/txt_color_address"
                        android:ellipsize="end"
                        android:id="@+id/id_indian_embassy_name"
                        android:tag="binding_15"
                        android:background="@drawable/edit_text_style"
                        android:paddingLeft="@dimen/_5sdp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:hint="Enter your indian embassy name"
                        android:maxLines="1"
                        android:inputType="textCapCharacters"
                        android:paddingStart="@dimen/_5sdp"/>
                    <com.nic.mparivahan.dlservices.widget.MyTextView
                        android:textSize="@dimen/_13sdp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_embassy_place"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text="@string/ind_emm_place"
                        android:fontFamily="@font/roboto_medium"/>
                    <EditText
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@color/txt_color_address"
                        android:ellipsize="end"
                        android:id="@+id/id_indian_embassy_place"
                        android:tag="binding_16"
                        android:background="@drawable/edit_text_style"
                        android:paddingLeft="@dimen/_8sdp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:hint="Enter your embassy place"
                        android:maxLines="1"
                        android:inputType="textCapCharacters"
                        android:paddingStart="@dimen/_5sdp"/>
                    <com.nic.mparivahan.dlservices.widget.MyTextView
                        android:textSize="@dimen/_13sdp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_foren_nation_mob"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text="@string/for_nat_mn"
                        android:fontFamily="@font/roboto_medium"/>
                    <EditText
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@color/txt_color_address"
                        android:ellipsize="end"
                        android:id="@+id/id_ind_embassy_mobile"
                        android:tag="binding_17"
                        android:background="@drawable/edit_text_style"
                        android:paddingLeft="@dimen/_5sdp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:hint="Enter your foreign nation mobile no."
                        android:maxLines="1"
                        android:maxLength="15"
                        android:inputType="phone"
                        android:paddingStart="@dimen/_5sdp"/>
                    <com.nic.mparivahan.dlservices.widget.MyTextView
                        android:textSize="@dimen/_13sdp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_email_id"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text="@string/idp_email"
                        android:fontFamily="@font/roboto_medium"/>
                    <EditText
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@color/txt_color_address"
                        android:ellipsize="end"
                        android:id="@+id/id_ind_embassy_email"
                        android:tag="binding_18"
                        android:background="@drawable/edit_text_style"
                        android:paddingLeft="@dimen/_5sdp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:hint="Enter your email id"
                        android:maxLines="1"
                        android:inputType="textEmailAddress"
                        android:paddingStart="@dimen/_5sdp"/>
                    <com.nic.mparivahan.dlservices.widget.MyTextView
                        android:textSize="@dimen/_13sdp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_date_verif_embassy"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text="@string/var_date_emb"
                        android:fontFamily="@font/roboto_medium"/>
                    <EditText
                        android:textSize="@dimen/_12ssp"
