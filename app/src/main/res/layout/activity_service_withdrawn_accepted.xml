<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <include
        android:id="@+id/mHeader"
        layout="@layout/mvvm_header"/>
    <RelativeLayout
        android:gravity="top|left"
        android:background="@drawable/mvvm_linear"
        android:padding="@dimen/_8sdp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/mHeader">
        <com.nic.mparivahan.MyTextView
            android:textSize="@dimen/_16ssp"
            android:textColor="#ff4d526b"
            android:gravity="center"
            android:id="@+id/txtServiceWithdrawnAccepted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your request for service withdrawn is accepted"
            android:layout_above="@+id/imgWithdrawAccepted"
            android:fontFamily="@font/robot_bold"
            android:layout_marginHorizontal="@dimen/_10sdp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgWithdrawAccepted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            app:srcCompat="@drawable/ic_withdraw_accept_terms"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btnOkay"
            android:background="@drawable/button_cyan_theme"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_30sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            android:minHeight="50dp"
            android:text="@string/ok_text"
            android:layout_alignParentBottom="true"
            android:textAllCaps="false"/>
    </RelativeLayout>
</RelativeLayout>
