<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_dl_status_documents_0"
    android:background="@drawable/layerlistexample"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/multi_head"
        android:visibility="gone"
        layout="@layout/multiheader"/>
    <include
        android:id="@+id/headerLayout"
        android:visibility="visible"
        layout="@layout/mvvm_header"/>
    <androidx.core.widget.NestedScrollView
        android:background="@color/light_gray"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/mvvm_linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/linearLayout2"
                android:tag="binding_1"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header_layout">
                <LinearLayout
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/never_mix"
                        android:gravity="center"
                        android:id="@+id/dl_no_txt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/never_mix"
                        android:gravity="center"
                        android:id="@+id/txt_view_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_5sdp"
                        android:text="@string/view_dl_details"
                        android:layout_weight="1.5"
                        android:fontFamily="@font/poppins_regular"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_1sdp">
                    <com.nic.mparivahan.dlservices.widget.MyTextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/select_service_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/poppins_regular"/>
                    <LinearLayout
                        android:gravity="center"
                        android:padding="1dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp">
                        <androidx.cardview.widget.CardView
                            android:id="@+id/icon_image"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginLeft="20dp"
                            android:layout_centerHorizontal="true"
                            app:cardCornerRadius="30dp">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/avtar_icon"/>
                        </androidx.cardview.widget.CardView>
                        <androidx.cardview.widget.CardView
                            android:id="@+id/round_card_view"
                            android:visibility="visible"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginLeft="0dp"
                            android:layout_centerHorizontal="true"
                            app:cardCornerRadius="30dp">
                            <ImageView
                                android:id="@+id/iv_report_traffic_violation_icon"
                                android:layout_width="50dp"
                                android:layout_height="50dp"/>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
                <include
                    android:id="@+id/psl"
                    layout="@layout/dl_renewal_header"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:background="@drawable/sarathi_text"
                        android:padding="@dimen/_5sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#ffdbe7ec">
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@+id/tv_appln_detail"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Applicant Details"
                            android:layout_weight="1"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/app_arrow_up"
                            android:background="@drawable/ic_arrow_up"
                            android:visibility="gone"
                            android:layout_width="@dimen/_25sdp"
                            android:layout_height="@dimen/_25sdp"
                            android:layout_marginRight="10dp"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/app_arrow_down"
                            android:background="@drawable/ic_arrow_down"
                            android:layout_width="@dimen/_25sdp"
                            android:layout_height="@dimen/_25sdp"
                            android:layout_marginRight="10dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/ll_app_layout"
                        android:background="@drawable/edit_text_style"
                        android:padding="10dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="10dp">
                            <TextView
                                android:textColor="@color/black"
                                android:id="@+id/tv_appln_no"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Application Number "/>
                            <TextView
                                android:textColor="@color/gray"
                                android:id="@+id/application_number_textview"
                                android:background="@drawable/edit_text_style"
                                android:padding="@dimen/_10sdp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/_8sdp"
                                android:backgroundTint="#ffffffff"/>
                            <TextView
                                android:textColor="@color/black"
                                android:id="@+id/tv_appln_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:text="Application Date"/>
                            <TextView
                                android:textColor="@color/gray"
                                android:id="@+id/doc_appl_date"
                                android:background="@drawable/edit_text_style"
                                android:padding="@dimen/_10sdp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/_8sdp"
                                android:backgroundTint="#ffffffff"/>
                            <TextView
                                android:textColor="@color/black"
                                android:id="@+id/tv_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:text="Name"/>
                            <TextView
                                android:textColor="@color/gray"
                                android:id="@+id/doc_appl_name"
                                android:background="@drawable/edit_text_style"
                                android:padding="@dimen/_10sdp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/_8sdp"
                                android:backgroundTint="#ffffffff"/>
                            <TextView
                                android:textColor="@color/black"
                                android:id="@+id/tv_son_daugh_wife"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:text="Son/Wife/Daughter of"/>
                            <TextView
                                android:textColor="@color/gray"
                                android:id="@+id/doc_appl_fname"
                                android:background="@drawable/edit_text_style"
                                android:padding="@dimen/_10sdp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/_8sdp"
                                android:backgroundTint="#ffffffff"/>
                            <TextView
                                android:textColor="@color/black"
                                android:id="@+id/tv_dob"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:text="Date of Birth"/>
                            <TextView
                                android:textColor="@color/gray"
                                android:id="@+id/doc_appl_dob"
                                android:background="@drawable/edit_text_style"
                                android:padding="@dimen/_10sdp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/_8sdp"
                                android:backgroundTint="#ffffffff"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <View
                android:id="@+id/view8"
                android:background="@color/contentBadgeTitle"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:id="@+id/textView"
                android:paddingLeft="10dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Upload Required Documents"
                android:layout_alignParentLeft="true"
                android:fontFamily="@font/lato"/>
            <View
                android:id="@+id/view9"
                android:background="@color/contentBadgeTitle"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="11dp"
                android:textStyle="bold"
                android:textColor="@color/vehicle_fit"
                android:gravity="center"
                android:id="@+id/textView2"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Allow file types (JPEG/JPG/PDF) and Maximum File Size is 200KB."
                android:fontFamily="@font/lato"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="4dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp">
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/shimmer_view_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:tag="binding_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include layout="@layout/items_dl_renewal_doc_place_holder"/>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/upload_list_rv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/button_layout_button"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp">
                <com.nic.mparivahan.dlservices.widget.CustomWegetLayout
                    android:id="@+id/upload_documents"
                    android:background="@drawable/sign_in_new"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_weight="1"
                    app:buttonText="Upload Document"
                    app:buttonTextColor="@color/white"
                    app:buttonTextSize="15dp"
                    app:progressColor="#ffffffff"
                    app:progressWidth="1dp"/>
                <com.nic.mparivahan.dlservices.widget.CustomWegetLayout
                    android:layout_gravity="center"
                    android:id="@+id/skipped_upload_doc"
                    android:background="@drawable/sign_in_new"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_5sdp"
                    app:buttonText="Next"
                    app:buttonTextColor="@color/white"
                    app:buttonTextSize="15dp"
                    app:progressColor="#ffffffff"
                    app:progressWidth="1dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
